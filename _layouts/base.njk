    <div class="brand">
      <a class="logo-link" href="https://smartsvg.io">
        <svg id="drwfTlJs-hdr-bar" role="img" lang="en" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMin slice" viewBox="0 0 899 206" aria-labelledby="drwfTlJs_title-hdr-bar">
          <!-- The brand lockup: the Equivalent mark, the Smart SVG wordmark, and the
               "Powered by Equivalent" line under it. Drawn as TWO paths, one per brand
               color, rather than one path per letter: the email header is rasterised
               from this file by src/lib/email/logoAsset.ts, which reads the desktop
               group as "the accent path and the ink path" and nothing else, and a
               glyph-per-path export would hand it twenty-nine.

               aria-labelledby as well as the title element: role="img" plus a title is
               enough in Chrome and Firefox, and Safari has historically read neither
               without the explicit reference. This is the site's home link, so a name
               that fails in one browser costs a screen reader user the way back to the
               start.

               Note the wording above avoids writing the title element as a literal tag.
               A comment is not markup, but every metadata reader here finds the element
               with a regex rather than a parser, and the first match would be this
               comment: the asset's accessible name would become a paragraph about
               Safari. -->
          <title id="drwfTlJs_title-hdr-bar">Smart SVG™ by Equivalent</title>
          <style>
            /* The two brand colors are the site's own heading and label tokens, so the
       lockup follows the theme toggle without a light and a dark copy. The
       literal fallbacks only apply where the site's stylesheet is absent (the
       file opened on its own, or the admin's library preview), and there the
       operating system picks the pair. */
            #drwfTlJs-hdr-bar {
                color-scheme: light dark;
                width: 100%;
                background-color: transparent;
                --brandFont: var(--text-heading-default, #171717);
                --brandAccent: var(--text-label-primary, #0066cc);
            }
            @media (prefers-color-scheme: dark) {
                #drwfTlJs-hdr-bar {
                    --brandFont: var(--text-heading-default, #ffffff);
                    --brandAccent: var(--text-label-primary, #00ccff);
                }
            }
            #drwfTlJs_desktop-group-hdr-bar { display: initial; }
            #drwfTlJs_mobile-group-hdr-bar { display: none; }
            /* Under 768px the lockup is replaced by the mark on its own. The
       aspect-ratio guard keeps a browser without support on the lockup
       rather than on a shape it cannot size. The mark is 102 x 137 units in
       a 899 x 206 frame; scaled 1.5x it fills the 154 x 206 window that a
       0.75 aspect box shows of this viewBox under xMinYMin slice. */
            @supports (aspect-ratio: auto) {
                @media (max-width: 768px) {
                    #drwfTlJs_desktop-group-hdr-bar { display: none; }
                    #drwfTlJs_mobile-group-hdr-bar { display: initial; transform: scale(1.5); }
                    #drwfTlJs-hdr-bar { width: auto; height: 44px; aspect-ratio: 0.75; max-height: 100%; }
                }
            }
            .eq-asset-12pj5q-st1-lt { fill: var(--brandFont); }
            .eq-asset-12pj5q-st2-lt { fill: var(--brandAccent); }
            .eq-asset-o5hub8-st0-lt { fill: var(--brandFont); }
            .eq-asset-o5hub8-st1-lt { fill: var(--brandAccent); }
            /* Forced colors: hand the mark over to the reader's own palette. The
       masked copy is painted in CanvasText so the shape survives a high
       contrast theme that would otherwise flatten both brand colors to one. */
            @media (forced-colors: active) {
                #drwfTlJs_masked-paths-hdr-bar { filter: saturate(0); }
                #drwfTlJs_CTO-hdr-bar { display: initial; }
            }
            @media (forced-colors: active) and (prefers-color-scheme: light) {
                #drwfTlJs_masked-paths-hdr-bar { filter: saturate(0) invert(1); }
            }
          </style>
